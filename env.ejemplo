# Copia este archivo con el nombre .env (punto env, sin nada más).
# El .env no se sube a GitHub.

# --- Base de datos ---
# Con Docker: deja estos valores tal cual; docker compose crea la base con ellos.
# Con PostgreSQL instalado (pgAdmin): pon la contraseña que elegiste al
# instalarlo (el usuario casi siempre es postgres) y crea una base llamada actas.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=actas
DB_USER=postgres
DB_PASSWORD=postgres

# --- Aplicativo ---
# Clave para firmar la sesión. En desarrollo sirve cualquier texto largo.
SECRET_KEY=cambia-esta-clave-por-un-texto-largo-y-secreto
# Carpeta donde se guardan adjuntos y firmas
UPLOAD_DIR=uploads
